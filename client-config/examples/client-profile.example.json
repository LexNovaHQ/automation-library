  "deployment": {
    "environment": "production",
    "automation_platform": "n8n",
    "n8n_instance": "client_workspace",
    "status_table": "google_sheets",
    "error_log_table": "google_sheets",
    "credential_profile": "growthops_prod",
    "workspace_isolation_required": true
