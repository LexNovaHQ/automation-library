  "assembly_preferences": {
    "default_build_environment": "n8n",
    "preferred_output_format": "stepwise_build_instructions",
    "allow_custom_adapter_builds": true,
    "manual_review_default": true,
    "prefer_existing_components": true,
    "adapter_gap_action": "flag_and_scope_custom_build",
    "documentation_required": true,
    "assembly_engine_notes": "Assembly engine should prefer existing built components and flag missing live adapters before final build."
  }
