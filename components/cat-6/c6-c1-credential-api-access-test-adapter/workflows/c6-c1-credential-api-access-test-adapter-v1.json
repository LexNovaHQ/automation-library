    {"parameters":{"jsCode":"const x=$input.first().json||{};\nconst allowed=['none','bearer_token','header_api_key'];\nconst method=String(x.method||'GET').toUpperCase();\nif(!x.request_id) return [{json:{valid:false,error_code:'MISSING_REQUEST_ID',error_message:'request_id is required.'}}];\nif(!x.url) return [{json:{valid:false,error_code:'MISSING_URL',error_message:'url is required.'}}];\nif(!['GET','POST','HEAD'].includes(method)) return [{json:{valid:false,error_code:'UNSUPPORTED_METHOD',error_message:'C6-C1 v1 supports GET, POST, and HEAD tests only.'}}];\nconst auth=String(x.auth_mode||'none');\nif(!allowed.includes(auth)) return [{json:{valid:false,error_code:'UNSUPPORTED_AUTH_MODE',error_message:`Unsupported auth mode ${auth}.`}}];\nif(auth!=='none' && !x.credential?.secret) return [{json:{valid:false,error_code:'MISSING_TEST_CREDENTIAL',error_message:'A test credential secret is required at execution time but will not be returned.'}}];\nreturn [{json:{valid:true,request_id:x.request_id,url:x.url,method,auth_mode:auth,header_name:x.credential?.header_name||'X-API-Key',secret:x.credential?.secret||'',body:x.body||{},started_at:new Date().toISOString()}}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-480,0],"id":"304999dc-66f9-48a3-b62e-660a796c111b","name":"Validate And Prepare Access Test"},
