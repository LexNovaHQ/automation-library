{"name":"C3-F_CORE_Delivery_Tracking_v1","nodes":[{"parameters":{"inputSource":"passthrough"},"type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[-240,0],"id":"80b14952-d002-4004-b116-72e3e320e6c8","name":"When Executed by Another Workflow"},{"parameters":{"jsCode":"const r=$input.first().json||{};const items=r.items||r.input?.items||[];if(!Array.isArray(items)||!items.length) return [{json:{success:false,component_id:'C3-F',component_version:'v1',error:{code:'NO_DELIVERY_ITEMS',message:'items[] is required.'},next_action:'provide_delivery_items'}}];const allowed=['not_started','in_progress','blocked','ready_for_review','approved','delivered'];const n=items.map((x,i)=>({...x,id:x.id||`item_${i+1}`,status:allowed.includes(x.status)?x.status:'not_started'}));const delivered=n.filter(x=>x.status==='delivered').length;const approved=n.filter(x=>x.status==='approved').length;const blocked=n.filter(x=>x.status==='blocked');const pct=Math.round((n.filter(x=>['approved','delivered'].includes(x.status)).length/n.length)*100);const status=blocked.length?'blocked':delivered===n.length?'complete':pct>0?'in_progress':'not_started';return [{json:{success:true,component_id:'C3-F',component_version:'v1',delivery:{status,completion_percent:pct,items:n,blocked_items:blocked.map(x=>x.id),delivered_count:delivered,approved_count:approved},next_action:blocked.length?'resolve_blockers':status==='complete'?'close_delivery':'continue_delivery',error:null}}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[40,0],"id":"42e2962a-13e0-4331-be23-bdfbef2d2a85","name":"Run Component Logic"}],"connections":{"When Executed by Another Workflow":{"main":[[{"node":"Run Component Logic","type":"main","index":0}]]}},"active":false,"settings":{"executionOrder":"v1"},"tags":[]}