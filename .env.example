# Copy this file to .env on the local machine. Never commit .env.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
N8N_SECURE_COOKIE=false

# REQUIRED: generate a fresh random value per machine/instance.
# PowerShell example:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
N8N_ENCRYPTION_KEY=REPLACE_WITH_FRESH_RANDOM_SECRET

# Provider adapter TEST/SANDBOX settings. Leave blank until configuring that adapter.
# Prefer n8n Credentials for client/production deployments; these variables exist for controlled local verification.
GHL_ACCESS_TOKEN=
NOTION_API_TOKEN=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
MS_GRAPH_ACCESS_TOKEN=
